FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends clamav clamav-freshclam ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY worker.py server.py selftest.py .
RUN useradd --uid 10001 --create-home medi
USER medi
ENV PORT=8080 MEDI_MAX_EXPANDED_BYTES=201326592
EXPOSE 8080
CMD ["python", "server.py"]
