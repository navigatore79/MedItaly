{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh; connect-src 'self' https://ejlhgtodmcadmdhbujkf.supabase.co wss://ejlhgtodmcadmdhbujkf.supabase.co; img-src 'self' data: blob: https://ejlhgtodmcadmdhbujkf.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/documenti",
      "destination": "/?legal="
    },
    {
      "source": "/privacy",
      "destination": "/?legal=privacy"
    },
    {
      "source": "/privacy-clinician",
      "destination": "/?legal=privacy-clinician"
    },
    {
      "source": "/terms",
      "destination": "/?legal=terms"
    },
    {
      "source": "/security",
      "destination": "/?legal=security"
    },
    {
      "source": "/retention",
      "destination": "/?legal=retention"
    },
    {
      "source": "/beta",
      "destination": "/?legal=beta"
    },
    {
      "source": "/medi-ai",
      "destination": "/?legal=medi-ai"
    },
    {
      "source": "/ip",
      "destination": "/?legal=ip"
    },
    {
      "source": "/proprieta-intellettuale",
      "destination": "/?legal=ip"
    },
    {
      "source": "/subprocessors",
      "destination": "/?legal=subprocessors"
    }
  ]
}
